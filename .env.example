# Login form (leave APP_PASSWORD empty to make the app public)
APP_USERNAME=user
APP_PASSWORD=
# How long a login stays valid on a device, in days
SESSION_DAYS=180
# Optional: separate signing key for the session cookie (defaults to one derived from the password)
SESSION_SECRET=
# Domain Traefik routes to this app
APP_DOMAIN=jpg.aaaaaaaaa9000.cloud
